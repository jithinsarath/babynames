// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_URL_UNPOOLED")
}

enum Gender {
  BOY
  GIRL
}

enum VoteChoice {
  YES
  NO
  MAYBE
}

enum SuggestionStatus {
  PENDING
  APPROVED
  REJECTED
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String?
  image     String?
  isViewer  Boolean  @default(false)
  createdAt DateTime @default(now())

  votes             Vote[]
  voteEvents        VoteEvent[]
  rankings          Ranking[]
  namesAdded        Name[]             @relation("NameCreatedBy")
  pushSubscriptions PushSubscription[]
  suggestions       NameSuggestion[]
}

model Name {
  id             String   @id @default(cuid())
  text           String
  normalizedText String
  meaning        String?
  gender         Gender
  createdAt      DateTime @default(now())
  createdById    String?
  createdBy      User?    @relation("NameCreatedBy", fields: [createdById], references: [id])

  votes      Vote[]
  voteEvents VoteEvent[]
  rankings   Ranking[]

  @@unique([normalizedText, gender], name: "uniq_name_per_gender")
  @@index([gender])
}

model Vote {
  id           String     @id @default(cuid())
  userId       String
  nameId       String
  choice       VoteChoice
  decisionMs   Int?
  flipCount    Int        @default(0)
  deckPosition Int?
  viaSearch    Boolean    @default(false)
  updatedAt    DateTime   @updatedAt
  createdAt    DateTime   @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  name Name @relation(fields: [nameId], references: [id], onDelete: Cascade)

  @@unique([userId, nameId])
}

model VoteEvent {
  id           String     @id @default(cuid())
  userId       String
  nameId       String
  choice       VoteChoice
  decisionMs   Int?
  deckPosition Int?
  viaSearch    Boolean    @default(false)
  createdAt    DateTime   @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  name Name @relation(fields: [nameId], references: [id], onDelete: Cascade)

  @@index([userId, nameId, createdAt])
}

model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model NameSuggestion {
  id             String           @id @default(cuid())
  text           String
  normalizedText String
  meaning        String?
  gender         Gender
  status         SuggestionStatus @default(PENDING)
  suggestedById  String
  suggestedBy    User             @relation(fields: [suggestedById], references: [id])
  createdAt      DateTime         @default(now())
  reviewedAt     DateTime?

  @@index([status])
}

model Ranking {
  id            String   @id @default(cuid())
  userId        String
  nameId        String
  score         Int
  revisionCount Int      @default(0)
  updatedAt     DateTime @updatedAt
  createdAt     DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  name Name @relation(fields: [nameId], references: [id], onDelete: Cascade)

  @@unique([userId, nameId])
}
